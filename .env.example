# Локальная разработка: скопируйте в .env. В проде переменные задаются в Coolify (infra/coolify/deploy.py).
SECRET_KEY=change-me
# Вход через SkolStream (docs/deploy.md)
SKOLSTREAM__BASE_URL=https://skolstream.sk.ru
SKOLSTREAM__CLIENT_ID=
SKOLSTREAM__CLIENT_SECRET=
SKOLSTREAM__DIRECTORY_TOKEN=
# Перенос из NocoBase: python -m app.cli nocobase-fetch /data/nocobase
NOCOBASE_URL=
NOCOBASE_API_KEY=
